<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Declutter</AssemblyName>
    <RootNamespace>Declutter</RootNamespace>
    <Version>1.0.3</Version>
    <!-- Point these at your own install, or pass them on the command line: dotnet build -p:ValheimDir=... -->
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(ValheimDir)\BepInEx\core</BepInExCore>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icons\*.png" LogicalName="%(Filename).png" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(ValheimDir)\valheim_Data\Managed\assembly_valheim.dll" Private="false" />
    <Reference Include="$(ValheimDir)\valheim_Data\Managed\assembly_guiutils.dll" Private="false" />
    <Reference Include="$(ValheimDir)\valheim_Data\Managed\assembly_utils.dll" Private="false" />
    <Reference Include="$(ValheimDir)\valheim_Data\Managed\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(ValheimDir)\valheim_Data\Managed\UnityEngine*.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
  </ItemGroup>
</Project>
